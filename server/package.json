{
  "name": "express-pocketbase-api",
  "version": "1.0.0",
  "description": "Express.js TypeScript REST API boilerplate with PocketBase SDK",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "express",
    "typescript",
    "pocketbase",
    "rest-api",
    "boilerplate"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "openai": "^6.14.0",
    "pocketbase": "^0.21.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "bun-types": "^1.3.4",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "supertest": "^7.1.4",
    "tsc": "^2.0.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
